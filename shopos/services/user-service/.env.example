# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3002

# ─── MongoDB ─────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/shopos_users

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT Verification ───────────────────────────────────
# JWKS URL from Auth Service (production: internal service URL)
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
# Fallback: direct public key for dev/testing (PEM, newlines as \n)
JWT_PUBLIC_KEY=

# ─── AWS S3 (Avatar Storage) ────────────────────────────
AWS_S3_BUCKET=shopos-avatars
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── CDN (CloudFront) ───────────────────────────────────
CDN_BASE_URL=https://cdn.shopos.dev

# ─── Kafka ───────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=user-service

# ─── Frontend URL ───────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Rate Limiting ──────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── MongoDB ─────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/shopos_auth

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT (RS256) ─────────────────────────────────────────
# Leave empty to auto-generate key pair in development.
# In production, provide PEM-encoded keys (newlines as \n).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800

# ─── Email ───────────────────────────────────────────────
# Resend is primary; set API key to enable.
RESEND_API_KEY=
EMAIL_FROM=noreply@shopos.dev

# Nodemailer SMTP fallback (used when RESEND_API_KEY is empty)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# ─── Kafka ───────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=auth-service

# ─── Frontend URL (for email links) ─────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Rate Limiting ──────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

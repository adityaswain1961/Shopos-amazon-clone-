{
  "name": "@shopos/auth-service",
  "version": "0.1.0",
  "private": true,
  "description": "ShopOS Auth Service — JWT RS256, RBAC, token rotation, email verification",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "clean": "rm -rf dist",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@shopos/shared-types": "*",
    "@shopos/observability": "*",
    "@shopos/jwt-verifier": "*",
    "express": "^4.21.0",
    "mongoose": "^8.9.0",
    "ioredis": "^5.4.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "jose": "^5.9.0",
    "zod": "^3.24.0",
    "kafkajs": "^2.2.4",
    "nodemailer": "^6.9.0",
    "resend": "^4.0.0",
    "uuid": "^11.0.0",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "@types/jest": "^29.5.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "moduleNameMapper": {
      "^@shopos/shared-types$": "<rootDir>/../../packages/shared-types/src",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": ["ts-jest", {
        "tsconfig": "tsconfig.test.json",
        "diagnostics": false
      }]
    },
    "clearMocks": true,
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/**/__tests__/**"
    ]
  }
}

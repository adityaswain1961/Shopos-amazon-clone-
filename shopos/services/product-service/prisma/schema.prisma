datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?   @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(150)
  description String?
  bannerUrl   String?   @map("banner_url")
  depth       Int       @default(0)
  path        String?   // materialized path e.g. /electronics/phones
  createdAt   DateTime  @default(now()) @map("created_at")

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  attributes  CategoryAttribute[]

  @@map("categories")
}

model Product {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String    @map("seller_id") @db.Uuid
  categoryId     String?   @map("category_id") @db.Uuid
  title          String    @db.VarChar(300)
  slug           String    @unique @db.VarChar(350)
  description    String?
  highlights     String[]
  specs          Json?
  status         String    @default("draft") @db.VarChar(20) // draft|published|archived|out_of_stock
  basePrice      Decimal   @map("base_price") @db.Decimal(12, 2)
  comparePrice   Decimal?  @map("compare_price") @db.Decimal(12, 2)
  costPrice      Decimal?  @map("cost_price") @db.Decimal(12, 2)
  taxClass       String?   @map("tax_class") @db.VarChar(50)
  currency       String    @default("INR") @db.Char(3)
  tags           String[]
  seoTitle       String?   @map("seo_title") @db.VarChar(200)
  seoDescription String?   @map("seo_description") @db.VarChar(500)
  isFeatured     Boolean   @default(false) @map("is_featured")
  isSponsored    Boolean   @default(false) @map("is_sponsored")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  category      Category?         @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  images        ProductImage[]
  videos        ProductVideo[]
  priceHistory  PriceHistory[]

  @@map("products")
}

model ProductVariant {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  sku        String    @unique @db.VarChar(100)
  barcode    String?   @db.VarChar(100)
  attributes Json?     // e.g. { "color": "Red", "size": "XL" }
  price      Decimal?  @db.Decimal(12, 2)
  createdAt  DateTime  @default(now()) @map("created_at")

  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  images       ProductImage[]
  priceHistory PriceHistory[]

  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  url        String
  position   Int      @default(0)
  altText    String?  @map("alt_text") @db.VarChar(200)
  isPrimary  Boolean  @default(false) @map("is_primary")

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("product_images")
}

model ProductVideo {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  hlsUrl     String?  @map("hls_url")
  thumbnail  String?
  durationS  Int?     @map("duration_s")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_videos")
}

model PriceHistory {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String?   @map("product_id") @db.Uuid
  variantId  String?   @map("variant_id") @db.Uuid
  price      Decimal?  @db.Decimal(12, 2)
  changedAt  DateTime  @default(now()) @map("changed_at")
  changedBy  String?   @map("changed_by") @db.Uuid // Seller or admin ID

  product    Product?        @relation(fields: [productId], references: [id])
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("price_history")
}

model CategoryAttribute {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  attrKey     String   @map("attr_key") @db.VarChar(100)
  attrType    String   @map("attr_type") @db.VarChar(30) // text|number|boolean|select
  options     String[] // For select type
  isRequired  Boolean  @default(false) @map("is_required")

  category    Category? @relation(fields: [categoryId], references: [id])

  @@map("category_attributes")
}

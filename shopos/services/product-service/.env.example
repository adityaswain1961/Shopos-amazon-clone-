# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3003

# ─── Database (PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopos_products?schema=public

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Kafka ───────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=product-service

# ─── AWS S3 & CloudFront CDN ────────────────────────────
AWS_S3_BUCKET=shopos-products
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_BASE_URL=http://localhost:3003/uploads

# ─── JWT Authentication Fallback ────────────────────────
# Public key from Auth Service for local signature checks.
# Leave empty to load dynamically via JWKS endpoint.
JWT_PUBLIC_KEY=

# ─── Rate Limiting ──────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Frontend ───────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

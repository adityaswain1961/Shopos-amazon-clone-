{
  "title": "ShopOS Overview",
  "uid": "shopos-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Request rate (req/s)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(shopos_http_requests_total[5m]))",
          "legendFormat": "total"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate %",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum(rate(shopos_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(shopos_http_requests_total[5m]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P99 latency by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(shopos_http_request_duration_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(shopos_http_requests_total[5m])) by (service, status_code)",
          "legendFormat": "{{service}} {{status_code}}"
        }
      ]
    }
  ]
}

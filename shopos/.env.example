# ShopOS environment template — copy to .env (never commit .env).
# docker-compose.yml has working defaults for local dev; everything marked
# REQUIRED IN PROD is enforced by docker-compose.prod.yml / the services.

# ─── Datastores ─────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password          # REQUIRED IN PROD
MONGO_PASSWORD=change_me_mongo_password              # REQUIRED IN PROD
REDIS_PASSWORD=change_me_redis_password              # REQUIRED IN PROD
MONGO_URI=mongodb://admin:change_me_mongo_password@mongodb:27017/auth?authSource=admin
MONGO_USERS_URI=mongodb://admin:change_me_mongo_password@mongodb:27017/users?authSource=admin

# ─── Auth ───────────────────────────────────────────────────────────
# One RS256 key shared by ALL auth replicas (generate: `make jwt-key`).
# Empty in dev = auto-generated per process (single replica only).
JWT_PRIVATE_KEY=                                     # REQUIRED IN PROD
# Only during key rotation: previous public key, so old tokens keep working
JWT_PREVIOUS_PUBLIC_KEY=
BCRYPT_ROUNDS=11

# ─── Service-to-service ─────────────────────────────────────────────
INTERNAL_API_TOKEN=change_me_long_random_string       # REQUIRED IN PROD

# ─── Payments ───────────────────────────────────────────────────────
# mock = every payment succeeds instantly (dev). stripe = real payments.
PAYMENT_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email (cheapest first) ─────────────────────────────────────────
# Amazon SES via SMTP is usually the cheapest at volume; Resend is easy for small volumes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
EMAIL_FROM=ShopOS <noreply@example.com>

# ─── Object storage (product images, avatars) ───────────────────────
# Any S3-compatible store. Cloudflare R2 has no egress fees (images are
# your biggest egress cost); Backblaze B2 and MinIO also work.
AWS_S3_BUCKET=shopos-media
AWS_S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=                  # e.g. https://<account-id>.r2.cloudflarestorage.com
CDN_BASE_URL=https://media.example.com

# ─── Optional AI (any OpenAI-compatible endpoint; empty = template answers, $0) ──
OPENAI_API_KEY=
OPENAI_BASE_URL=              # e.g. http://ollama:11434/v1 for a self-hosted model
AI_MODEL=gpt-4o-mini

# ─── Observability ──────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change_me_grafana
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ─── Frontend ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

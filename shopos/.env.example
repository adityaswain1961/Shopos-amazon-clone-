# ShopOS environment template — copy to .env (never commit .env)
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=shopos_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=shopos_db
DATABASE_URL=postgresql://shopos_admin:change_me_strong_password@localhost:5432/shopos_db

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo_password
MONGO_URI=mongodb://admin:change_me_mongo_password@localhost:27017/auth?authSource=admin

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Auth / JWT (production: load from Vault)
JWT_PRIVATE_KEY=
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json

# Payments (production: Vault path shopos/data/payment)
STRIPE_SECRET_KEY=sk_test_replace_me
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email
RESEND_API_KEY=

# Observability
GRAFANA_ADMIN_PASSWORD=change_me_grafana
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
